;; NothingOS-style temperature widget

(defpoll WASISTLOS_NOTIFICATION :interval "10s" "scripts/get-wasistlos.sh")

;; Define the temperature polling
(defpoll TEMPERATURE :interval "10s" "scripts/get-temp.sh")

;; Temperature widget
(defwidget temp-widget []
  (box :class "nothing-temp" 
       :orientation "v" 
       :space-evenly false 
       :halign "center" 
       :valign "center"
    (box :class "temp-content" 
         :orientation "v" 
         :space-evenly false 
         :halign "center" 
         :valign "center"
      (label :class "temp-icon" :text "󰔏")
      (box :orientation "h" 
           :space-evenly false 
           :halign "center"
        (label :class "temp-value" :text TEMPERATURE)
        (label :class "temp-unit" :text "°C")
      )
    )
  )
)

;; Main window definition
(defwindow cpu-temp
  :monitor 0
  :geometry (geometry :x "10px"
                     :y "50px" ;; Moved down
                     :width "150px"
                     :height "150px")
  :stacking "bottom"
  :windowtype "desktop"
  :sticky true
  :wm-ignore false
  :class "widget-window"
  (temp-widget))

;; Spotify Now Playing Widget
(defpoll MEDIA :initial '{"title":"No media playing","image":"scripts/media-fallback.svg"}' :interval "5s" "scripts/get-media.sh --json")

(defwidget spotify-widget []
  (box :class "nothing-spotify" 
       :orientation "v" 
       :space-evenly false 
       :halign "center" 
       :valign "center"
    (box :class "spotify-content" 
         :orientation "v" 
         :space-evenly false 
         :halign "center" 
         :valign "center"
      (image :class "media-art" :path "${MEDIA.image}" :image-width 64 :image-height 64)
      (label :class "spotify-track" :text "${MEDIA.title}" :wrap true :limit-width 18)
    )
  )
)

;; Spotify Now Playing Window
(defwindow spotify-now-playing
  :monitor 0
  :geometry (geometry :x "170px"
                     :y "50px" ;; Moved down
                     :width "150px"
                     :height "150px")
  :stacking "bottom"
  :windowtype "desktop"
  :sticky true
  :wm-ignore false
  :class "widget-window"
  (spotify-widget))

;; Quote of the Day Widget
(defpoll QUOTE :interval "10s" "shuf -n 1 ~/.config/eww/quotes.txt")

(defwidget quote-widget []
  (box :class "nothing-quote" 
       :orientation "v" 
       :space-evenly false 
       :halign "center" 
       :valign "center"
    (box :class "quote-content" 
         :orientation "v" 
         :space-evenly false 
         :halign "center" 
         :valign "center"
      (label :class "quote-icon" :text "󰃬") ;; Quote icon
      (label :class "quote-text" :text QUOTE :wrap true :limit-width 32)
    )
  )
)

;; Quote of the Day Window
(defwindow quote-of-the-day
  :monitor 0
  :geometry (geometry :x "10px"
                     :y "210px" ;; Moved down
                     :width "310px"
                     :height "150px")
  :stacking "bottom"
  :windowtype "desktop"
  :sticky true
  :wm-ignore false
  :class "widget-window"
  (quote-widget))

;; Weather Widget
(defpoll WEATHER :initial '{"temp":"--","description":"Toshkent"}' :interval "10m" "scripts/get-weather.sh")

(defwidget weather-widget []
  (box :class "nothing-weather" 
       :orientation "v" 
       :space-evenly false 
       :halign "center" 
       :valign "center"
    (label :class "weather-icon" :text "󰖐") ;; Weather icon
    (box :orientation "h" :halign "center" :space-evenly false
      (label :class "weather-temp" :text "${WEATHER.temp}")
      (label :class "weather-unit" :text "°C")
    )
    (label :class "weather-desc" :text "${WEATHER.description}" :wrap true :limit-width 18)
  )
)

;; Weather Window
(defwindow weather-widget
  :monitor 0
  :geometry (geometry :x "10px"
                     :y "370px" ;; Moved down
                     :width "150px"
                     :height "150px")
  :stacking "bottom"
  :windowtype "desktop"
  :sticky true
  :wm-ignore false
  :class "widget-window"
  (weather-widget))

;; Day of the Month Widget
(defpoll CURRENT_DAY :interval "1h" "date +'%d'")

(defwidget day-widget []
  (box :class "nothing-day" 
       :orientation "v" 
       :space-evenly false 
       :halign "center" 
       :valign "center"
    (label :class "day-number" :text CURRENT_DAY)
  )
)

;; Day of the Month Window
(defwindow day-of-month
  :monitor 0
  :geometry (geometry :x "170px"
                     :y "370px" ;; Moved down
                     :width "150px"
                     :height "150px")
  :stacking "bottom"
  :windowtype "desktop"
  :sticky true
  :wm-ignore false
  :class "widget-window"
  (day-widget))

  (defwidget wasistlos-widget []
  (box :class "nothing-wasistlos" 
       :orientation "v" 
       :space-evenly false 
       :halign "center" 
       :valign "center"
    (box :class "wasistlos-content" 
         :orientation "v" 
         :space-evenly false 
         :halign "center" 
         :valign "center"
      (label :class "wasistlos-icon" :text "󰍡") ;; Notification icon
      (label :class "wasistlos-text" :text WASISTLOS_NOTIFICATION :wrap true) ;; Notification text
    )
  )
)

(defwindow wasistlos-widget
  :monitor 0
  :geometry (geometry :x "330px"
                     :y "370px" ;; Adjust position as needed
                     :width "150px"
                     :height "150px")
  :stacking "bottom"
  :windowtype "desktop"
  :sticky true
  :wm-ignore false
  :class "widget-window"
  (wasistlos-widget))
