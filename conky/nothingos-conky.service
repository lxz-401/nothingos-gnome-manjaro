[Unit]
Description=NothingOS desktop system monitor
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/lib/nothingos/conky -c %h/.config/conky/nothing-phone-conky.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
