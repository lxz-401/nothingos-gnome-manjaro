      * @public
      * @returns {void}
      */
+    // An installer may temporarily exclude browser MPRIS players while the old
+    // cached modules are still running. Restore only those entries on fresh load.
+    restorePreviewPlayers() {
+        const path = GLib.build_filenamev([this.path, "preview-fix-pending.json"]);
+        if (!GLib.file_test(path, GLib.FileTest.EXISTS)) return;
+        try {
+            const [ok, bytes] = GLib.file_get_contents(path);
+            if (!ok) return;
+            const pending = JSON.parse(new TextDecoder().decode(bytes));
+            if (pending.version !== 1 || !Array.isArray(pending.temporaryBlacklist) ||
+                !pending.temporaryBlacklist.every(name => typeof name === "string")) return;
+            const settings = this.getSettings();
+            const current = settings.get_strv("blacklisted-players");
+            if (!settings.set_strv("blacklisted-players",
+                current.filter(name => !pending.temporaryBlacklist.includes(name)))) return;
+            Gio.Settings.sync();
+            GLib.unlink(path);
+        } catch (error) {
+            errorLog("Could not restore preview players", error);
+        }
+    }
+
     enable() {
+        debugLog("Preview optimization active: bounded listeners, lazy popup, bounded timeline");
         this.playerProxies = new Map();
+        this.restorePreviewPlayers();
         this.initSettings();
         this.initProxies().catch(errorLog);
         this.updateMediaNotificationVisiblity();
